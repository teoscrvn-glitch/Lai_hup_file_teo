# Server
PORT=5000
NODE_ENV=production
BASE_URL=https://your-domain.com

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=laihupfile_user
DB_PASSWORD=change_this_password
DB_NAME=laihupfile

# JWT (access token — NGẮN HẠN, không dùng để "nhớ đăng nhập")
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=15m

# Refresh token (đăng nhập bền vững — lưu hash trong DB, có thể thu hồi)
REFRESH_TOKEN_SECRET=change_this_to_another_long_random_string
REFRESH_TOKEN_EXPIRES_IN=30d
REFRESH_TOKEN_REMEMBER_EXPIRES_IN=90d

# Trang quản trị — đường dẫn bí mật, KHÔNG chia sẻ, đổi giá trị random trước khi deploy
ADMIN_PANEL_PATH=admin-panel-x7q9k2

# Link tải file — thời hạn ngắn, dùng 1 lần
DOWNLOAD_TOKEN_EXPIRES_MIN=5

# Chống brute-force đăng nhập
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Chặn IP lạm dụng API (tầng ứng dụng, bổ sung cho Nginx/Cloudflare nếu có)
IP_BLOCK_WINDOW_MIN=1
IP_BLOCK_THRESHOLD=120
IP_BLOCK_MINUTES=30

# Upload
UPLOAD_MAX_SIZE_MB=200
UPLOAD_DIR=uploads

# Bank info (mặc định, admin có thể sửa trong settings)
BANK_NAME=Vietcombank
BANK_ACCOUNT_NAME=NGUYEN VAN A
BANK_ACCOUNT_NUMBER=0123456789

# Rate limit
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=200

# Admin seed (chỉ dùng 1 lần khi chạy npm run seed:admin)
SEED_ADMIN_EMAIL=admin@laihupfile.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change_this_password_now
